<screen>
	<animations>
		<timeline name="screen_open">
			<animation prop="opa" target="top_bar" start="0" end="255" duration="180" delay="0" early_apply="true" />
			<animation
				prop="translate_y"
				target="top_bar"
				start="-20"
				end="0"
				duration="180"
				delay="0"
				early_apply="true"
			/>

			<animation prop="opa" target="main_card" start="0" end="255" duration="220" delay="80" early_apply="true" />
			<animation
				prop="translate_x"
				target="main_card"
				start="40"
				end="0"
				duration="220"
				delay="80"
				early_apply="true"
			/>

			<animation
				prop="opa"
				target="phase_card"
				start="0"
				end="255"
				duration="220"
				delay="160"
				early_apply="true"
			/>
			<animation
				prop="translate_x"
				target="phase_card"
				start="-35"
				end="0"
				duration="220"
				delay="160"
				early_apply="true"
			/>

			<animation
				prop="opa"
				target="freq_card"
				start="0"
				end="255"
				duration="220"
				delay="220"
				early_apply="true"
			/>
			<animation
				prop="translate_x"
				target="freq_card"
				start="35"
				end="0"
				duration="220"
				delay="220"
				early_apply="true"
			/>

			<animation
				prop="opa"
				target="hint_card"
				start="0"
				end="255"
				duration="220"
				delay="300"
				early_apply="true"
			/>
			<animation
				prop="translate_y"
				target="hint_card"
				start="25"
				end="0"
				duration="220"
				delay="300"
				early_apply="true"
			/>

			<animation
				prop="opa"
				target="bottom_bar"
				start="0"
				end="255"
				duration="180"
				delay="380"
				early_apply="true"
			/>
			<animation
				prop="translate_y"
				target="bottom_bar"
				start="20"
				end="0"
				duration="180"
				delay="380"
				early_apply="true"
			/>
		</timeline>
	</animations>

	<styles>
		<style name="style_screen_bg" bg_color="0x0b1220" />
		<style name="style_card" bg_color="0x111c2e" border_color="0x26384f" border_width="1" radius="8" pad_all="6" />
		<style
			name="style_card_main"
			bg_color="0x10263c"
			border_color="0x2e5a7a"
			border_width="1"
			radius="10"
			pad_all="8"
		/>
		<style
			name="style_card_focused"
			border_width="2"
			border_color="0x35cfff"
			border_opa="255"
			shadow_width="8"
			shadow_color="0x35cfff"
			shadow_opa="90"
			radius="14"
		/>

		<style name="style_text_normal" text_color="0xd8e2f0" text_font="font_cn_12" />
		<style name="style_text_muted" text_color="0x8fa3bf" text_font="font_cn_12" />
		<style name="style_text_value" text_color="0x4dd4ff" text_font="font_cn_18" />
		<style name="style_text_big_value" text_color="0x4dd4ff" text_font="font_cn_24" />
		<style name="style_text_ok" text_color="0x61d394" text_font="font_cn_12" />
		<style name="style_text_warn" text_color="0xffd166" text_font="font_cn_12" />
	</styles>

	<view>
		<play_timeline_event target="self" timeline="screen_open" trigger="screen_loaded" />
		<style name="style_screen_bg" />

		<top_status_bar name="top_bar" x="0" y="0" title_text="电压/频率" time_text="12:30" comm_text="WiFi" />

		<lv_obj name="main_card" x="10" y="38" width="220" height="62" scrollbar_mode="off">
			<style name="style_card_main" />
			<style name="style_card_focused" selector="focused" />
			<lv_label x="0" y="0" text="当前电压">
				<style name="style_text_muted" />
			</lv_label>
			<lv_label name="label_voltage_main" x="0" y="23" text="---.- V">
				<style name="style_text_big_value" />
			</lv_label>
			<lv_label name="label_voltage_status" x="158" y="32" text="正常">
				<style name="style_text_ok" />
			</lv_label>
		</lv_obj>

		<lv_obj name="phase_card" x="10" y="108" width="105" height="72" scrollbar_mode="off">
			<style name="style_card" />
			<style name="style_card_focused" selector="focused" />
			<lv_label x="0" y="0" text="Ua">
				<style name="style_text_muted" />
			</lv_label>
			<lv_label name="label_voltage_ua" x="34" y="0" text="---.-V">
				<style name="style_text_value" />
			</lv_label>
			<lv_label x="0" y="24" text="Ub">
				<style name="style_text_muted" />
			</lv_label>
			<lv_label name="label_voltage_ub" x="34" y="24" text="---.-V">
				<style name="style_text_value" />
			</lv_label>
			<lv_label x="0" y="48" text="Uc">
				<style name="style_text_muted" />
			</lv_label>
			<lv_label name="label_voltage_uc" x="34" y="48" text="---.-V">
				<style name="style_text_value" />
			</lv_label>
		</lv_obj>

		<lv_obj name="freq_card" x="125" y="108" width="105" height="72" scrollbar_mode="off">
			<style name="style_card" />
			<style name="style_card_focused" selector="focused" />
			<lv_label x="0" y="0" text="频率">
				<style name="style_text_muted" />
			</lv_label>
			<lv_label name="label_frequency" x="0" y="22" text="--.--Hz">
				<style name="style_text_value" />
			</lv_label>
			<lv_label x="0" y="48" text="状态">
				<style name="style_text_muted" />
			</lv_label>
			<lv_label name="label_phase_status" x="38" y="48" text="正常">
				<style name="style_text_ok" />
			</lv_label>
		</lv_obj>

		<lv_obj name="hint_card" x="10" y="188" width="220" height="22" scrollbar_mode="off">
			<style name="style_card" />
			<lv_label name="label_voltage_hint" x="0" y="0" text="异常提示：无过压/欠压/断相">
				<style name="style_text_ok" />
			</lv_label>
		</lv_obj>

		<bottom_key_bar
			name="bottom_bar"
			x="0"
			y="218"
			left_text="上/下 切页"
			center_text="确认 详情"
			right_text="3/8"
		/>
	</view>
</screen>
