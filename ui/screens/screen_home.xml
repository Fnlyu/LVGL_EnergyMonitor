<screen>
	<animations>
		<timeline name="screen_open">
			<animation prop="opa" target="top_bar" start="0" end="255" duration="180" delay="0" early_apply="true" />
			<animation
				prop="translate_y"
				target="top_bar"
				start="-20"
				end="0"
				duration="180"
				delay="0"
				early_apply="true"
			/>

			<animation prop="opa" target="main_card" start="0" end="255" duration="220" delay="80" early_apply="true" />
			<animation
				prop="translate_x"
				target="main_card"
				start="-40"
				end="0"
				duration="220"
				delay="80"
				early_apply="true"
			/>

			<animation
				prop="opa"
				target="today_card"
				start="0"
				end="255"
				duration="220"
				delay="160"
				early_apply="true"
			/>
			<animation
				prop="translate_x"
				target="today_card"
				start="-35"
				end="0"
				duration="220"
				delay="160"
				early_apply="true"
			/>

			<animation
				prop="opa"
				target="month_card"
				start="0"
				end="255"
				duration="220"
				delay="220"
				early_apply="true"
			/>
			<animation
				prop="translate_x"
				target="month_card"
				start="35"
				end="0"
				duration="220"
				delay="220"
				early_apply="true"
			/>

			<animation
				prop="opa"
				target="bottom_bar"
				start="0"
				end="255"
				duration="180"
				delay="380"
				early_apply="true"
			/>
			<animation
				prop="translate_y"
				target="bottom_bar"
				start="20"
				end="0"
				duration="180"
				delay="380"
				early_apply="true"
			/>
		</timeline>
	</animations>

	<styles>
		<style name="style_screen_bg" bg_color="0x05070a" />
		<style name="style_card" bg_color="0x101821" border_color="0x1a2632" border_width="1" radius="8" pad_all="6" />
		<style
			name="style_card_main"
			bg_color="0x0b1118"
			border_color="0x172331"
			border_width="1"
			radius="10"
			pad_all="8"
		/>

		<style
			name="style_card_focused"
			border_width="2"
			border_color="0x35cfff"
			border_opa="255"
			shadow_width="8"
			shadow_color="0x35cfff"
			shadow_opa="90"
			radius="14"
		/>

		<style name="style_text_normal" text_color="0xd8e2f0" text_font="font_cn_12" />
		<style name="style_text_muted" text_color="0xbfd6ec" text_font="font_cn_16" />
		<style name="style_text_biaoti_da" text_color="0xbfd6ec" text_font="font_cn_18" />
		<style name="style_text_value_xiao" text_color="0xe6eef5" text_font="font_cn_20" />
		<style name="style_text_value" text_color="0x20e6d2" text_font="font_cn_34" />
		<style name="style_text_value_KW" text_color="0xe6eef5" text_font="font_cn_34" />
		<style name="style_text_ok" text_color="0x61d394" text_font="font_cn_12" />
		<style name="style_text_warn" text_color="0xffd166" text_font="font_cn_12" />

		<style name="style_accent_cyan" bg_color="0x20e6d2" border_width="0" radius="3" pad_all="0" />
		<style name="style_accent_green" bg_color="0x32f27a" border_width="0" radius="3" pad_all="0" />
		<style name="style_accent_yellow" bg_color="0xffb020" border_width="0" radius="3" pad_all="0" />
	</styles>

	<view>
		<play_timeline_event target="self" timeline="screen_open" trigger="screen_load_start" />
		<style name="style_screen_bg" />

		<top_status_bar
			name="top_bar"
			x="0"
			y="0"
			title_text="家庭能量监测"
			time_text="12:30"
			comm_text="WiFi"
			style_opa="0"
			style_translate_y="-20"
		/>

		<lv_obj name="main_card" x="10" y="38" width="220" height="92" style_opa="0" style_translate_x="-40">
			<style name="style_card_main" />

			<style name="style_card_focused" selector="focused" />

			<lv_label x="0" y="2" width="200" text="当前总功率" style_text_align="center">
				<style name="style_text_biaoti_da" />
			</lv_label>

			<lv_obj
				name="power_row"
				x="0"
				y="30"
				width="200"
				height="40"
				scrollable="false"
				flex_flow="row"
				style_flex_main_place="center"
				style_flex_cross_place="center"
				style_bg_opa="0"
				style_border_width="0"
				style_pad_all="0"
				style_pad_column="0"
			>
				<lv_label name="label_total_power" text="6722.33">
					<style name="style_text_value" />
				</lv_label>

				<lv_label name="label_total_power_unit" text="KW">
					<style name="style_text_value_KW" />
				</lv_label>
			</lv_obj>
		</lv_obj>

		<lv_obj
			name="today_card"
			x="10"
			y="140"
			width="105"
			height="70"
			scrollable="false"
			style_opa="0"
			style_translate_x="-35"
		>
			<style name="style_card" />

			<style name="style_card_focused" selector="focused" />

			<lv_obj x="0" y="0" width="3" height="52">
				<style name="style_accent_yellow" />
			</lv_obj>
			<lv_label x="10" y="0" text="今日用电">
				<style name="style_text_muted" />
			</lv_label>
			<lv_obj
				name="day_power_row"
				x="10"
				y="25"
				width="100"
				height="20"
				scrollable="false"
				flex_flow="row"
				style_flex_main_place="start"
				style_flex_cross_place="center"
				style_bg_opa="0"
				style_border_width="0"
				style_pad_all="0"
				style_pad_column="0"
			>
				<lv_label name="label_day_power" text="672.33">
					<style name="style_text_value_xiao" />
				</lv_label>

				<lv_label name="label_day_power_unit" text="KW">
					<style name="style_text_value_xiao" />
				</lv_label>
			</lv_obj>
		</lv_obj>

		<lv_obj
			name="month_card"
			x="125"
			y="140"
			width="105"
			height="70"
			scrollable="false"
			style_opa="0"
			style_translate_x="35"
		>
			<style name="style_card" />

			<style name="style_card_focused" selector="focused" />

			<lv_obj x="0" y="0" width="3" height="52">
				<style name="style_accent_green" />
			</lv_obj>
			<lv_label x="10" y="0" text="本月用电">
				<style name="style_text_muted" />
			</lv_label>
			<lv_obj
				name="month_power_row"
				x="10"
				y="25"
				width="100"
				height="20"
				scrollable="false"
				flex_flow="row"
				style_flex_main_place="start"
				style_flex_cross_place="center"
				style_bg_opa="0"
				style_border_width="0"
				style_pad_all="0"
				style_pad_column="0"
			>
				<lv_label name="label_month_power" text="6722.3">
					<style name="style_text_value_xiao" />
				</lv_label>

				<lv_label name="label_month_power_unit" text="KW">
					<style name="style_text_value_xiao" />
				</lv_label>
			</lv_obj>
		</lv_obj>

		<bottom_key_bar
			name="bottom_bar"
			x="0"
			y="218"
			left_text="上/下 切页"
			center_text="确认 详情"
			right_text="1/8"
			style_opa="0"
			style_translate_y="20"
		/>
	</view>
</screen>
