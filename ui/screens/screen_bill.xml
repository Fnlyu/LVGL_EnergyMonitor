<screen>
	<animations>
		<timeline name="screen_open">
			<animation prop="opa" target="top_bar" start="0" end="255" duration="180" delay="0" early_apply="true" />
			<animation
				prop="translate_y"
				target="top_bar"
				start="-20"
				end="0"
				duration="180"
				delay="0"
				early_apply="true"
			/>
			<animation
				prop="opa"
				target="scroll_container"
				start="0"
				end="255"
				duration="250"
				delay="80"
				early_apply="true"
			/>
			<animation
				prop="translate_x"
				target="scroll_container"
				start="-35"
				end="0"
				duration="250"
				delay="80"
				early_apply="true"
			/>
			<animation
				prop="opa"
				target="bottom_bar"
				start="0"
				end="255"
				duration="180"
				delay="380"
				early_apply="true"
			/>
			<animation
				prop="translate_y"
				target="bottom_bar"
				start="20"
				end="0"
				duration="180"
				delay="380"
				early_apply="true"
			/>
		</timeline>
	</animations>
	<styles>
		<style name="style_screen_bg" bg_color="0x05070a" />
		<style name="style_card" bg_color="0x101821" border_color="0x1a2632" border_width="1" radius="8" pad_all="6" />
		<style
			name="style_card_focused"
			border_width="2"
			border_color="0x35cfff"
			border_opa="255"
			shadow_width="6"
			shadow_color="0x35cfff"
			shadow_opa="80"
			radius="12"
		/>
		<style name="style_text_title" text_color="0xbfd6ec" text_font="font_cn_14" />
		<style name="style_text_muted" text_color="0x8fa3bf" text_font="font_cn_12" />
		<style name="style_text_value" text_color="0x4dd4ff" text_font="font_cn_12" />
		<style name="style_text_normal" text_color="0xd8e2f0" text_font="font_cn_12" />
		<style name="style_text_highlight" text_color="0xffd166" text_font="font_cn_12" />
		<style name="style_text_ok" text_color="0x61d394" text_font="font_cn_12" />
		<style name="style_text_money" text_color="0x20e6d2" text_font="font_cn_24" />
		<!--  图表样式  -->
		<style name="style_chart_bill" bg_opa="0" border_width="0" radius="0" pad_all="0" />
		<style name="style_chart_items_bill" bg_color="0x20e6d2" bg_opa="255" radius="2" />
		<style name="style_chart_indicator_hidden" bg_opa="0" />
	</styles>
	<view>
		<play_timeline_event target="self" timeline="screen_open" trigger="screen_load_start" />
		<style name="style_screen_bg" />
		<!--  顶部状态栏  -->
		<top_status_bar
			name="top_bar"
			x="0"
			y="0"
			title_text="电费账单"
			time_text="12:30"
			comm_text="WiFi"
			style_opa="0"
			style_translate_y="-20"
		/>
		<!--  可滚动主容器  -->
		<lv_obj
			name="scroll_container"
			x="10"
			y="38"
			width="220"
			height="172"
			scrollable="true"
			style_opa="0"
			style_translate_x="-35"
			style_bg_opa="0"
			style_border_width="0"
			style_pad_all="0"
			style_pad_row="6"
		>
			<!--  ====== 卡片1：本月电费预估 ======  -->
			<lv_obj name="card_estimate" x="0" y="0" width="220" height="70" scrollable="false">
				<style name="style_card" />
				<style name="style_card_focused" selector="focused" />
				<lv_label x="4" y="2" text="本月电费预估">
					<style name="style_text_title" />
				</lv_label>
				<!--  金额  -->
				<lv_label x="4" y="22" text="￥128.50">
					<style name="style_text_money" />
				</lv_label>
				<!--  对比信息  -->
				<lv_label x="100" y="26" text="较上月">
					<style name="style_text_normal" />
				</lv_label>
				<lv_label x="150" y="26" text="↑ 5.2%">
					<style name="style_text_highlight" />
				</lv_label>
				<lv_label x="100" y="44" text="较去年同期">
					<style name="style_text_normal" />
				</lv_label>
				<lv_label x="160" y="44" text="↓ 2.1%">
					<style name="style_text_ok" />
				</lv_label>
			</lv_obj>
			<!--  ====== 卡片2：阶梯电价分段 ======  -->
			<lv_obj name="card_tier" x="0" y="76" width="220" height="80" scrollable="false">
				<style name="style_card" />
				<style name="style_card_focused" selector="focused" />
				<lv_label x="4" y="2" text="阶梯电价（当前：第二阶梯）">
					<style name="style_text_title" />
				</lv_label>
				<lv_label x="4" y="20" text="单价">
					<style name="style_text_normal" />
				</lv_label>
				<lv_label x="50" y="20" text="0.68 元/度">
					<style name="style_text_value" />
				</lv_label>
				<lv_label x="120" y="20" text="已用电">
					<style name="style_text_normal" />
				</lv_label>
				<lv_label x="170" y="20" text="210 度">
					<style name="style_text_value" />
				</lv_label>
				<lv_label x="4" y="36" text="剩余阶梯">
					<style name="style_text_normal" />
				</lv_label>
				<lv_label x="70" y="36" text="90 度（升至第三阶）">
					<style name="style_text_highlight" />
				</lv_label>
			</lv_obj>
		</lv_obj>
		<!--  底部三按键栏  -->
		<bottom_key_bar
			name="bottom_bar"
			x="0"
			y="218"
			left_text="上/下 切页"
			center_text="确认 详情"
			right_text="6/8"
			style_opa="0"
			style_translate_y="20"
		/>
	</view>
</screen>
