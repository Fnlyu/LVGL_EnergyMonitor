<screen>
	<animations>
		<timeline name="screen_open">
			<animation prop="opa" target="top_bar" start="0" end="255" duration="180" delay="0" early_apply="true" />
			<animation
				prop="translate_y"
				target="top_bar"
				start="-20"
				end="0"
				duration="180"
				delay="0"
				early_apply="true"
			/>
			<animation
				prop="opa"
				target="scroll_container"
				start="0"
				end="255"
				duration="250"
				delay="80"
				early_apply="true"
			/>
			<animation
				prop="translate_x"
				target="scroll_container"
				start="-35"
				end="0"
				duration="250"
				delay="80"
				early_apply="true"
			/>
			<animation
				prop="opa"
				target="bottom_bar"
				start="0"
				end="255"
				duration="180"
				delay="380"
				early_apply="true"
			/>
			<animation
				prop="translate_y"
				target="bottom_bar"
				start="20"
				end="0"
				duration="180"
				delay="380"
				early_apply="true"
			/>
		</timeline>
	</animations>
	<styles>
		<style name="style_screen_bg" bg_color="0x05070a" />
		<style name="style_card" bg_color="0x101821" border_color="0x1a2632" border_width="1" radius="8" pad_all="6" />
		<style
			name="style_card_focused"
			border_width="2"
			border_color="0x35cfff"
			border_opa="255"
			shadow_width="6"
			shadow_color="0x35cfff"
			shadow_opa="80"
			radius="12"
		/>
		<style name="style_text_title" text_color="0xbfd6ec" text_font="font_cn_14" />
		<style name="style_text_muted" text_color="0x8fa3bf" text_font="font_cn_12" />
		<style name="style_text_value" text_color="0x4dd4ff" text_font="font_cn_12" />
		<style name="style_text_normal" text_color="0xd8e2f0" text_font="font_cn_12" />
		<style name="style_text_highlight" text_color="0xffd166" text_font="font_cn_12" />
		<style name="style_text_ok" text_color="0x61d394" text_font="font_cn_12" />
		<!--  进度条背景样式  -->
		<style name="style_progress_bg" bg_color="0x1a2632" radius="2" />
		<!--  进度条填充样式（各时段颜色不同）  -->
		<style name="style_progress_peak" bg_color="0xff4757" radius="2" />
		<style name="style_progress_flat" bg_color="0xffd166" radius="2" />
		<style name="style_progress_valley" bg_color="0x61d394" radius="2" />
	</styles>
	<view>
		<play_timeline_event target="self" timeline="screen_open" trigger="screen_load_start" />
		<style name="style_screen_bg" />
		<!--  顶部状态栏  -->
		<top_status_bar
			name="top_bar"
			x="0"
			y="0"
			title_text="能效分析"
			time_text="12:30"
			comm_text="WiFi"
			style_opa="0"
			style_translate_y="-20"
		/>
		<!--  可滚动主容器  -->
		<lv_obj
			name="scroll_container"
			x="10"
			y="38"
			width="220"
			height="172"
			scrollable="true"
			style_opa="0"
			style_translate_x="-35"
			style_bg_opa="0"
			style_border_width="0"
			style_pad_all="0"
			style_pad_row="6"
		>
			<!--  ====== 卡片2：同环比对比 ======  -->
			<lv_obj name="card_compare" x="0" y="5" width="220" height="65" scrollable="false">
				<style name="style_card" />
				<style name="style_card_focused" selector="focused" />
				<lv_label x="4" y="2" text="同环比对比">
					<style name="style_text_title" />
				</lv_label>
				<lv_label x="4" y="18" text="今日用电">
					<style name="style_text_muted" />
				</lv_label>
				<lv_label x="70" y="18" text="6.72 KWh">
					<style name="style_text_value" />
				</lv_label>
				<lv_label x="130" y="18" text="↑ 8.2%">
					<style name="style_text_highlight" />
				</lv_label>
				<lv_label x="4" y="34" text="本周用电">
					<style name="style_text_muted" />
				</lv_label>
				<lv_label x="70" y="34" text="42.3 KWh">
					<style name="style_text_value" />
				</lv_label>
				<lv_label x="130" y="34" text="↓ 3.1%">
					<style name="style_text_ok" />
				</lv_label>
			</lv_obj>
			<!--  ====== 卡片3：高耗电器 Top5 ======  -->
			<lv_obj name="card_top5" x="0" y="75" width="220" height="100" scrollable="false">
				<style name="style_card" />
				<style name="style_card_focused" selector="focused" />
				<lv_label x="4" y="2" text="高耗电器 Top5">
					<style name="style_text_title" />
				</lv_label>
				<lv_label x="6" y="18" text="1. 空调 2.30KW">
					<style name="style_text_normal" />
				</lv_label>
				<lv_label x="6" y="32" text="2. 厨房电器 1.85KW">
					<style name="style_text_normal" />
				</lv_label>
				<lv_label x="6" y="46" text="3. 热水器 1.20KW">
					<style name="style_text_normal" />
				</lv_label>
				<lv_label x="6" y="60" text="4. 电冰箱 0.95KW">
					<style name="style_text_normal" />
				</lv_label>
				<lv_label x="6" y="74" text="5. 洗衣机 0.72KW">
					<style name="style_text_normal" />
				</lv_label>
			</lv_obj>
			<!--  底部留白  -->
			<lv_obj x="0" y="248" width="1" height="1" style_bg_opa="0" style_border_width="0" />
		</lv_obj>
		<!--  底部三按键栏  -->
		<bottom_key_bar
			name="bottom_bar"
			x="0"
			y="218"
			left_text="上/下 切页"
			center_text="确认 详情"
			right_text="4/8"
			style_opa="0"
			style_translate_y="20"
		/>
	</view>
</screen>
