<component>
	<api>
		<prop name="title_text" type="string" default="家庭能量监测" />
		<prop name="time_text" type="string" default="12:30" />
		<prop name="comm_text" type="string" default="WiFi" />
		<prop name="comm_ok" type="string" default="●" />
	</api>

	<styles>
		<style
			name="style_top_bar"
			bg_color="0x0b1118"
			border_color="0x172331"
			border_width="0"
			radius="0"
			pad_all="0"
		/>
		<style name="style_text_title" text_color="0xffffff" text_font="font_cn_18" />
		<style name="style_text_muted" text_color="0x8fa3bf" text_font="font_cn_14" />
		<style name="style_text_ok" text_color="0x61d394" text_font="font_cn_14" />
	</styles>

	<view extends="lv_obj" width="240" height="32">
		<style name="style_top_bar" />
		<lv_label name="label_title" x="8" y="6" text="$title_text">
			<style name="style_text_title" />
		</lv_label>
		<lv_label name="label_time" x="142" y="9" text="$time_text">
			<style name="style_text_muted" />
		</lv_label>
		<lv_label name="label_comm_dot" x="184" y="9" text="$comm_ok">
			<style name="style_text_ok" />
		</lv_label>
		<lv_label name="label_wifi_top_status" x="202" y="9" text="$comm_text">
			<style name="style_text_muted" />
		</lv_label>
	</view>
</component>
