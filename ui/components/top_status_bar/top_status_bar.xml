<component>
    <api>
        <prop name="title_text" type="string" default="家庭能量监测" />
        <prop name="time_text" type="string" default="12:30" />
        <prop name="comm_text" type="string" default="WiFi" />
        <prop name="comm_ok" type="string" default="●" />
    </api>

    <styles>
        <style name="style_top_bar" bg_color="0x162033" border_width="0" radius="0" pad_all="0" />
        <style name="style_text_title" text_color="0xffffff" text_font="font_cn_14" />
        <style name="style_text_muted" text_color="0x8fa3bf" text_font="font_cn_12" />
        <style name="style_text_ok" text_color="0x61d394" text_font="font_cn_12" />
    </styles>

    <view extends="lv_obj" width="240" height="30">
        <style name="style_top_bar" />
        <lv_label name="label_title" x="8" y="7" text="$title_text">
            <style name="style_text_title" />
        </lv_label>
        <lv_label name="label_time" x="168" y="8" text="$time_text">
            <style name="style_text_muted" />
        </lv_label>
        <lv_label name="label_comm_dot" x="206" y="8" text="$comm_ok">
            <style name="style_text_ok" />
        </lv_label>
        <lv_label name="label_wifi_top_status" x="218" y="8" text="$comm_text">
            <style name="style_text_muted" />
        </lv_label>
    </view>
</component>
