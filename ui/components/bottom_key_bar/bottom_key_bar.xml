<component>
	<api>
		<prop name="left_text" type="string" default="上/下 切页" />
		<prop name="center_text" type="string" default="确认 详情" />
		<prop name="right_text" type="string" default="1/8" />
	</api>

	<styles>
		<style
			name="style_bottom_bar"
			bg_color="0x101821"
			border_color="0x172331"
			border_width="0"
			radius="0"
			pad_all="0"
		/>
		<style name="style_text_muted" text_color="0x8fa3bf" text_font="font_cn_12" />
		<style name="style_text_ok" text_color="0x61d394" text_font="font_cn_12" />
	</styles>

	<view extends="lv_obj" width="240" height="22">
		<style name="style_bottom_bar" />
		<lv_label name="label_key_left" x="8" y="5" text="$left_text">
			<style name="style_text_muted" />
		</lv_label>
		<lv_label name="label_key_center" x="92" y="5" text="$center_text">
			<style name="style_text_muted" />
		</lv_label>
		<lv_label name="label_page_index" x="196" y="5" text="$right_text">
			<style name="style_text_ok" />
		</lv_label>
	</view>
</component>
